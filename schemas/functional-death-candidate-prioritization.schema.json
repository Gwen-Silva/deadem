{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deadem.local/schemas/functional-death-candidate-prioritization.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "runKind", "artifactClass", "generatedBy", "generatedAt",
    "prioritizationModel", "configurationId", "scoreInputs", "selectionThreshold",
    "priorityThresholds", "replayIds", "v1CandidateCount", "candidateCount", "candidates",
    "finalFactsProduced", "attributionEmitted", "limitations"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "runKind": {"const": "task197-bounded32"},
    "artifactClass": {"const": "functional_death_candidate_prioritization"},
    "generatedBy": {"const": "tools/emit-functional-death-candidate-prioritization.mjs"},
    "generatedAt": {"const": "task_197"},
    "prioritizationModel": {"const": "deterministic_structural_priority_v2"},
    "configurationId": {"const": "task197-development-frozen-v2"},
    "scoreInputs": {
      "type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true,
      "items": {"enum": ["family_count", "surface_count", "observed_horizon_seconds", "same_surface_recurrence", "nearest_same_surface_gap_seconds"]}
    },
    "selectionThreshold": {"const": 0.65},
    "priorityThresholds": {
      "type": "object", "additionalProperties": false, "required": ["high", "medium", "low"],
      "properties": {"high": {"const": 0.9}, "medium": {"const": 0.78}, "low": {"const": 0.65}}
    },
    "replayIds": {
      "type": "array", "minItems": 32, "maxItems": 32, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^replay_(?!005|006|007|008)[0-9]{3}$"}
    },
    "v1CandidateCount": {"const": 2664},
    "candidateCount": {"type": "integer", "minimum": 1, "maximum": 2663},
    "candidates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/candidate"}},
    "finalFactsProduced": {"const": false},
    "attributionEmitted": {"const": false},
    "limitations": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "contribution": {
      "type": "object", "additionalProperties": false,
      "required": ["signal", "normalizedValue", "weight", "contribution"],
      "properties": {
        "signal": {"enum": ["family_diversity", "surface_support", "observed_horizon", "same_surface_recurrence", "temporal_density"]},
        "normalizedValue": {"type": "number", "minimum": 0, "maximum": 1},
        "weight": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.25},
        "contribution": {"type": "number", "minimum": 0, "maximum": 0.25}
      }
    },
    "labels": {
      "type": "object", "additionalProperties": false,
      "required": ["knownStructuralAnchor", "hardChallengerPopulation"],
      "properties": {"knownStructuralAnchor": {"type": "boolean"}, "hardChallengerPopulation": {"type": "boolean"}}
    },
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": [
        "candidateId", "replayId", "timestampSeconds", "priorityScore", "priorityLevel", "rankInReplay",
        "featureContributions", "observedHorizonSeconds", "abstractSurfaceId", "evaluationLabels", "semanticStatus", "finalFact"
      ],
      "properties": {
        "candidateId": {"type": "string", "pattern": "^replay_[0-9]{3}_candidate_[0-9]{4}$"},
        "replayId": {"type": "string", "pattern": "^replay_(?!005|006|007|008)[0-9]{3}$"},
        "timestampSeconds": {"type": "integer", "minimum": 0},
        "priorityScore": {"type": "number", "minimum": 0.65, "maximum": 1},
        "priorityLevel": {"enum": ["high", "medium", "low"]},
        "rankInReplay": {"type": "integer", "minimum": 1},
        "featureContributions": {"type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": {"$ref": "#/$defs/contribution"}},
        "observedHorizonSeconds": {"enum": [0, 10, 20, 30, 60, 120, 180]},
        "abstractSurfaceId": {"type": "string", "pattern": "^participant_[0-9]{2}:[a-z_]+(?:\\+[a-z_]+)?$"},
        "evaluationLabels": {"$ref": "#/$defs/labels"},
        "semanticStatus": {"const": "unconfirmed_structural_death_candidate_priority"},
        "finalFact": {"const": false}
      }
    }
  }
}
