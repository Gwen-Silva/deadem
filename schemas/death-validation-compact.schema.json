{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deadem.local/schemas/death-validation-compact.schema.json",
  "title": "Death Validation Compact Source Schema",
  "description": "Compact summary-only schema for death_validation. It records validation metadata only and forbids event rows, field values, snapshots, attribution, and gameplay interpretation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "replayId",
    "artifactClass",
    "sourceMethod",
    "eventCount",
    "duplicateKeyCount",
    "validationStatus",
    "limitations",
    "rawDataCaptured",
    "finalFactsProduced"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "replayId": {
      "type": "string",
      "pattern": "^replay_[0-9]{3}$"
    },
    "artifactClass": {
      "type": "string",
      "const": "death_validation"
    },
    "sourceMethod": {
      "type": "string",
      "enum": [
        "counter_transition_summary",
        "manifest_only",
        "not_evaluated"
      ]
    },
    "eventCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000
    },
    "duplicateKeyCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000
    },
    "validationStatus": {
      "type": "string",
      "enum": [
        "source_events_available_with_limitations",
        "no_counter_increments_observed",
        "source_validation_blocked",
        "not_evaluated"
      ]
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240
      }
    },
    "rawDataCaptured": {
      "type": "boolean",
      "const": false
    },
    "finalFactsProduced": {
      "type": "boolean",
      "const": false
    },
    "samplingPolicy": {
      "type": "string",
      "enum": [
        "manifest_only",
        "one_second_source_sampling",
        "not_evaluated"
      ]
    },
    "counterSource": {
      "type": "string",
      "enum": [
        "controller.m_iDeaths",
        "not_materialized"
      ]
    },
    "counterTransitionType": {
      "type": "string",
      "enum": [
        "death_counter_increment_summary",
        "not_materialized"
      ]
    },
    "validationWarnings": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 180
      }
    },
    "blockedFields": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "enum": [
          "event_rows",
          "entity_ids",
          "player_names",
          "hero_names",
          "team_names",
          "map_positions",
          "per_event_timestamps",
          "per_event_ticks",
          "killer",
          "victim",
          "assister",
          "damage_source",
          "fight_id",
          "objective_id",
          "field_values",
          "raw_values",
          "full_entity_snapshots",
          "player_arrays",
          "gameplay_interpretation_strings"
        ]
      },
      "uniqueItems": true
    },
    "policyVersion": {
      "type": "string",
      "const": "death_validation_compact_v1"
    },
    "generatedBy": {
      "type": "string",
      "maxLength": 80
    },
    "generatedAt": {
      "type": "string",
      "maxLength": 40
    }
  }
}
