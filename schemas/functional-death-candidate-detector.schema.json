{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deadem.local/schemas/functional-death-candidate-detector.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "runKind", "artifactClass", "generatedBy", "generatedAt", "detectorModel",
    "scoreThreshold", "replayIds", "candidateCount", "candidates", "finalFactsProduced",
    "attributionEmitted", "limitations"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "runKind": {"type": "string", "pattern": "^task196-(?:bounded32|single-replay_[0-9]{3})$"},
    "artifactClass": {"const": "functional_death_candidate_detector"},
    "generatedBy": {"const": "tools/emit-functional-death-candidate-detector.mjs"},
    "generatedAt": {"const": "task_196"},
    "detectorModel": {"const": "deterministic_structural_heuristic_v1"},
    "scoreThreshold": {"const": 0.85},
    "replayIds": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^replay_(?!005|006|007|008)[0-9]{3}$"}
    },
    "candidateCount": {"type": "integer", "minimum": 1},
    "candidates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/candidate"}},
    "finalFactsProduced": {"const": false},
    "attributionEmitted": {"const": false},
    "limitations": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "signal": {
      "type": "object", "additionalProperties": false,
      "required": ["signal", "weight"],
      "properties": {
        "signal": {"type": "string", "minLength": 1},
        "weight": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.3}
      }
    },
    "overlap": {
      "type": "object", "additionalProperties": false,
      "required": ["knownStructuralAnchor", "hardChallengerPopulation"],
      "properties": {
        "knownStructuralAnchor": {"type": "boolean"},
        "hardChallengerPopulation": {"type": "boolean"}
      }
    },
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": [
        "candidateId", "replayId", "timestampSeconds", "structuralScore", "contributingSignals",
        "observedHorizonSeconds", "abstractSurfaceId", "evaluationOverlap", "semanticStatus", "finalFact"
      ],
      "properties": {
        "candidateId": {"type": "string", "pattern": "^replay_[0-9]{3}_candidate_[0-9]{4}$"},
        "replayId": {"type": "string", "pattern": "^replay_(?!005|006|007|008)[0-9]{3}$"},
        "timestampSeconds": {"type": "integer", "minimum": 0},
        "structuralScore": {"type": "number", "minimum": 0.85, "maximum": 1},
        "contributingSignals": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/signal"}},
        "observedHorizonSeconds": {"enum": [0, 10, 20, 30, 60, 120, 180]},
        "abstractSurfaceId": {"type": "string", "pattern": "^participant_[0-9]{2}:[a-z_]+(?:\\+[a-z_]+)?$"},
        "evaluationOverlap": {"$ref": "#/$defs/overlap"},
        "semanticStatus": {"const": "unconfirmed_structural_death_candidate"},
        "finalFact": {"const": false}
      }
    }
  }
}
