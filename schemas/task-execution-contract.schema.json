{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deadem.local/schemas/task-execution-contract.schema.json",
  "title": "Codex task execution contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reasoningComplexity",
    "objective",
    "technicalContext",
    "confirmedState",
    "expectedBaseCommit",
    "branchEnvironment",
    "allowedScope",
    "protectedAreas",
    "expectedChanges",
    "acceptanceCriteria",
    "mandatoryTests",
    "requiredEvidence",
    "commitPolicy",
    "stopConditions",
    "returnReportFormat"
  ],
  "properties": {
    "reasoningComplexity": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "technicalContext": { "$ref": "#/$defs/nonEmptyStrings" },
    "confirmedState": { "$ref": "#/$defs/nonEmptyStrings" },
    "expectedBaseCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "branchEnvironment": { "$ref": "#/$defs/nonEmptyStrings" },
    "allowedScope": { "$ref": "#/$defs/nonEmptyStrings" },
    "protectedAreas": { "$ref": "#/$defs/nonEmptyStrings" },
    "expectedChanges": { "$ref": "#/$defs/nonEmptyStrings" },
    "acceptanceCriteria": { "$ref": "#/$defs/nonEmptyStrings" },
    "mandatoryTests": { "$ref": "#/$defs/nonEmptyStrings" },
    "requiredEvidence": { "$ref": "#/$defs/nonEmptyStrings" },
    "commitPolicy": { "$ref": "#/$defs/nonEmptyStrings" },
    "stopConditions": { "$ref": "#/$defs/nonEmptyStrings" },
    "returnReportFormat": { "$ref": "#/$defs/nonEmptyStrings" }
  },
  "$defs": {
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
