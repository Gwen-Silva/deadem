      "properties": {
        "preStateContinuityStatus": { "$ref": "#/$defs/preStatus" }, "forwardObserved": { "type": "boolean" }, "forwardDeltaSeconds": { "type": ["integer", "null"], "minimum": -2, "maximum": 2 },
