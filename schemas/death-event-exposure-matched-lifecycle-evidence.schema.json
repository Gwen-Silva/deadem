    "failureReason": { "enum": ["none", "pre_state_not_origin_continuous", "forward_not_observed", "forward_ambiguous", "forward_persistence_not_observed", "forward_persistence_contradiction", "inverse_not_observed_within_common_follow_up", "recovery_persistence_not_observed", "recovery_persistence_contradiction", "insufficient_common_follow_up", "cross_anchor_recovery"] },
    "family": {
