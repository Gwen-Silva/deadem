{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deadem.local/schemas/death-event-exposure-matched-lifecycle-evidence.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "replayId", "artifactClass", "generatedBy", "generatedAt", "rawDataCaptured", "rawFieldNamesIncludedInRows", "rawIdsIncluded", "rawTicksIncluded", "rawTimestampsIncluded", "finalFactsProduced", "attributionEmitted", "anchorCount", "exactPairCount", "evidenceRowCount", "evidenceRows", "summary", "readiness", "limitations"],
  "properties": {
    "schemaVersion": { "const": 1 }, "replayId": { "type": "string", "pattern": "^replay_[0-9]{3}$" },
    "artifactClass": { "const": "death_event_exposure_matched_lifecycle_evidence" }, "generatedBy": { "const": "tools/emit-death-event-exposure-matched-lifecycle-evidence.mjs" }, "generatedAt": { "const": "task_189" },
    "rawDataCaptured": { "const": false }, "rawFieldNamesIncludedInRows": { "const": false }, "rawIdsIncluded": { "const": false }, "rawTicksIncluded": { "const": false }, "rawTimestampsIncluded": { "const": false },
