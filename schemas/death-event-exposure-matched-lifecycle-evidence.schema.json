      "properties": { "totalAnchors": { "type": "integer", "minimum": 1 }, "totalExactControls": { "type": "integer", "minimum": 1 }, "exactPairCount": { "type": "integer", "minimum": 1 }, "originConsistentPreStateCoverage": { "$ref": "#/$defs/rate" }, "commonFollowUpDistribution": { "$ref": "#/$defs/distribution" }, "perFamilyChainRates": { "$ref": "#/$defs/familyRates" }, "analyzablePairCount": { "type": "integer", "minimum": 0 }, "anchorCoherentLifecycleRate": { "$ref": "#/$defs/rate" }, "controlCoherentLifecycleRate": { "$ref": "#/$defs/rate" }, "pairedDifference": { "type": "number", "minimum": -1, "maximum": 1 }, "insufficientFollowUpPairs": { "type": "integer", "minimum": 0 }, "controlsTruncatedByRealAnchors": { "type": "integer", "minimum": 0 }, "anchorsTruncatedByNextAnchors": { "type": "integer", "minimum": 0 }, "booleanRespawnOnlyCoherentRate": { "$ref": "#/$defs/rate" }, "crossSurfaceSupportRate": { "$ref": "#/$defs/rate" }, "crossAnchorRecoveryCount": { "type": "integer", "minimum": 0 }, "contradictionCount": { "type": "integer", "minimum": 0 }, "ambiguityCount": { "type": "integer", "minimum": 0 }, "sourceReuseCount": { "type": "integer", "minimum": 0 }, "horizonResults": { "type": "array", "minItems": 6, "maxItems": 6, "items": { "$ref": "#/$defs/horizon" } }, "exposureMatchedAssessmentLevel": { "enum": ["insufficient", "partial", "strong"] } }
    },
    "distribution": { "type": "object", "additionalProperties": false, "required": ["lessThan10", "seconds10To19", "seconds20To29", "seconds30To59", "seconds60To119", "seconds120To179", "seconds180"], "properties": { "lessThan10": { "type": "integer", "minimum": 0 }, "seconds10To19": { "type": "integer", "minimum": 0 }, "seconds20To29": { "type": "integer", "minimum": 0 }, "seconds30To59": { "type": "integer", "minimum": 0 }, "seconds60To119": { "type": "integer", "minimum": 0 }, "seconds120To179": { "type": "integer", "minimum": 0 }, "seconds180": { "type": "integer", "minimum": 0 } } },
    "familyRates": { "type": "object", "additionalProperties": false, "required": ["healthBoundary", "booleanAlive", "respawnBoundary", "pawnLinkPresence"], "properties": { "healthBoundary": { "$ref": "#/$defs/familyRate" }, "booleanAlive": { "$ref": "#/$defs/familyRate" }, "respawnBoundary": { "$ref": "#/$defs/familyRate" }, "pawnLinkPresence": { "$ref": "#/$defs/familyRate" } } },
    "familyRate": { "type": "object", "additionalProperties": false, "required": ["anchorCompleteRate", "controlCompleteRate"], "properties": { "anchorCompleteRate": { "$ref": "#/$defs/rate" }, "controlCompleteRate": { "$ref": "#/$defs/rate" } } },
    "readiness": { "type": "object", "additionalProperties": false, "required": ["originConsistentLifecycleEvidenceAvailable", "exposureMatchedControlComparisonMeasurable", "pairwiseLifecycleDiscriminationMeasurable", "sourceTierCompositionMeasurable", "candidateLevelExposureMatchedLifecycleConsumptionAvailable", "readyForOperationalDeathFactPromotionReview", "readyForFinalDeathFacts", "readyForConfirmedWhoDied", "readyForAttribution", "readyForKillerVictim", "readyForTeamfight", "readyForGameplayInterpretation"], "properties": { "originConsistentLifecycleEvidenceAvailable": { "const": true }, "exposureMatchedControlComparisonMeasurable": { "const": true }, "pairwiseLifecycleDiscriminationMeasurable": { "const": true }, "sourceTierCompositionMeasurable": { "const": true }, "candidateLevelExposureMatchedLifecycleConsumptionAvailable": { "const": true }, "readyForOperationalDeathFactPromotionReview": { "type": "boolean" }, "readyForFinalDeathFacts": { "const": false }, "readyForConfirmedWhoDied": { "const": false }, "readyForAttribution": { "const": false }, "readyForKillerVictim": { "const": false }, "readyForTeamfight": { "const": false }, "readyForGameplayInterpretation": { "const": false } } }
