        "completeSameFamilyLifecycle": { "type": "boolean" }, "failureReason": { "$ref": "#/$defs/failureReason" }
      }
    },
    "families": { "type": "object", "additionalProperties": false, "required": ["healthBoundary", "booleanAlive", "respawnBoundary", "pawnLinkPresence"], "properties": { "healthBoundary": { "$ref": "#/$defs/family" }, "booleanAlive": { "$ref": "#/$defs/family" }, "respawnBoundary": { "$ref": "#/$defs/family" }, "pawnLinkPresence": { "$ref": "#/$defs/family" } } },
