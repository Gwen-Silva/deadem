{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deadem.local/schemas/two-match-replay-video-sync.schema.json",
  "title": "Two-Match Replay to Video Mapping",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactClass",
    "axisInput",
    "axisOutput",
    "models",
    "silentExtrapolationAllowed",
    "displayedGameClockUsedAsGroundTruth"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "artifactClass": { "const": "two_match_replay_video_mapping" },
    "axisInput": { "const": "task199_replay_elapsed_seconds" },
    "axisOutput": { "const": "task198_vod_seconds" },
    "silentExtrapolationAllowed": { "const": false },
    "displayedGameClockUsedAsGroundTruth": { "const": false },
    "models": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/model" }
    }
  },
  "$defs": {
    "time": { "type": "number", "minimum": 0 },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segmentId",
        "replayStartSeconds",
        "replayEndSeconds",
        "videoStartSeconds",
        "videoEndSeconds",
        "slope",
        "interceptSeconds"
      ],
      "properties": {
        "segmentId": { "type": "string", "minLength": 1 },
        "replayStartSeconds": { "$ref": "#/$defs/time" },
        "replayEndSeconds": { "$ref": "#/$defs/time" },
        "videoStartSeconds": { "$ref": "#/$defs/time" },
        "videoEndSeconds": { "$ref": "#/$defs/time" },
        "slope": { "type": "number", "exclusiveMinimum": 0 },
        "interceptSeconds": { "type": "number" }
      }
    },
    "uncovered": {
      "type": "object",
      "additionalProperties": false,
      "required": ["afterSecondsExclusive", "endSecondsInclusive"],
      "properties": {
        "afterSecondsExclusive": { "$ref": "#/$defs/time" },
        "endSecondsInclusive": { "$ref": "#/$defs/time" }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewTargetId",
        "modelType",
        "equation",
        "segments",
        "coveredReplayRegion",
        "uncoveredReplayRegions",
        "rejectionPolicy",
        "estimatedErrorSeconds",
        "fitAnchorCount",
        "validationAnchorCount",
        "validationMaximumAbsoluteErrorSeconds"
      ],
      "properties": {
        "reviewTargetId": { "enum": ["review_match_001", "review_match_002"] },
        "modelType": { "enum": ["linear", "segmented"] },
        "equation": { "const": "video_seconds = slope * replay_elapsed_seconds + intercept_seconds" },
        "segments": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/segment" }
        },
        "coveredReplayRegion": {
          "type": "object",
          "additionalProperties": false,
          "required": ["startSeconds", "endSeconds"],
          "properties": {
            "startSeconds": { "$ref": "#/$defs/time" },
            "endSeconds": { "$ref": "#/$defs/time" }
          }
        },
        "uncoveredReplayRegions": {
          "type": "array",
          "items": { "$ref": "#/$defs/uncovered" }
        },
        "rejectionPolicy": { "const": "reject_outside_covered_region_without_extrapolation" },
        "estimatedErrorSeconds": { "type": "number", "minimum": 0 },
        "fitAnchorCount": { "type": "integer", "minimum": 2 },
        "validationAnchorCount": { "type": "integer", "minimum": 2 },
        "validationMaximumAbsoluteErrorSeconds": { "type": "number", "minimum": 0 }
      }
    }
  }
}
