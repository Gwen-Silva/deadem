{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deadem.local/schemas/death-event-surface-resolved-lifecycle-evidence.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "replayId",
    "artifactClass",
    "generatedBy",
    "generatedAt",
    "rawDataCaptured",
    "rawFieldNamesIncludedInRows",
    "rawIdsIncluded",
    "rawTicksIncluded",
    "rawTimestampsIncluded",
    "finalFactsProduced",
    "attributionEmitted",
    "anchorCount",
    "controlCount",
    "exactPairCount",
    "evidenceRowCount",
    "evidenceRows",
    "summary",
    "readiness",
    "limitations"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "replayId": { "type": "string", "pattern": "^replay_[0-9]{3}$" },
    "artifactClass": {
      "const": "death_event_surface_resolved_lifecycle_evidence"
    },
    "generatedBy": {
      "const": "tools/emit-death-event-surface-resolved-lifecycle-evidence.mjs"
    },
    "generatedAt": { "const": "task_190" },
    "rawDataCaptured": { "const": false },
    "rawFieldNamesIncludedInRows": { "const": false },
    "rawIdsIncluded": { "const": false },
    "rawTicksIncluded": { "const": false },
    "rawTimestampsIncluded": { "const": false },
    "finalFactsProduced": { "const": false },
    "attributionEmitted": { "const": false },
    "anchorCount": { "type": "integer", "minimum": 1 },
    "controlCount": { "type": "integer", "minimum": 1 },
    "exactPairCount": { "type": "integer", "minimum": 1 },
    "evidenceRowCount": { "type": "integer", "minimum": 1 },
    "evidenceRows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/row" }
    },
    "summary": { "$ref": "#/$defs/summary" },
    "readiness": { "$ref": "#/$defs/readiness" },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "rate": { "type": "number", "minimum": 0, "maximum": 1 },
    "surface": {
      "enum": [
        "controller_only",
        "linked_pawn_only",
        "controller_and_pawn_agree",
        "controller_pawn_conflict",
        "controller_link_relation",
        "surface_unavailable"
      ]
    },
    "preStatus": {
      "enum": [
        "event_relative_origin_continuous",
        "event_relative_wrong_origin",
        "event_relative_insufficient_pre_state",
        "event_relative_conflicting_pre_state",
        "event_relative_missing_immediate_pre_sample",
        "event_relative_intervening_transition"
      ]
    },
    "stageSurfaces": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preState",
        "forward",
        "forwardPersistence",
        "inverse",
        "recoveryPersistence"
      ],
      "properties": {
        "preState": { "$ref": "#/$defs/surface" },
        "forward": { "$ref": "#/$defs/surface" },
        "forwardPersistence": { "$ref": "#/$defs/surface" },
        "inverse": { "$ref": "#/$defs/surface" },
        "recoveryPersistence": { "$ref": "#/$defs/surface" }
      }
    },
    "family": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventRelativePreStateStatus",
        "forwardObserved",
        "forwardDeltaSeconds",
        "forwardPersistenceObserved",
        "inverseObserved",
        "inverseDeltaSeconds",
        "recoveryPersistenceObserved",
        "completionDeltaSeconds",
        "completeSameFamilyLifecycle",
        "stageSurfaceStatus",
        "failureReason"
      ],
      "properties": {
        "eventRelativePreStateStatus": { "$ref": "#/$defs/preStatus" },
        "forwardObserved": { "type": "boolean" },
        "forwardDeltaSeconds": {
          "type": ["integer", "null"],
          "minimum": -2,
          "maximum": 2
        },
        "forwardPersistenceObserved": { "type": "boolean" },
        "inverseObserved": { "type": "boolean" },
        "inverseDeltaSeconds": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 180
        },
        "recoveryPersistenceObserved": { "type": "boolean" },
        "completionDeltaSeconds": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 180
        },
        "completeSameFamilyLifecycle": { "type": "boolean" },
        "stageSurfaceStatus": { "$ref": "#/$defs/stageSurfaces" },
        "failureReason": {
          "enum": [
            "none",
            "pre_state_not_event_relative_continuous",
            "forward_not_observed",
            "forward_ambiguous",
            "forward_persistence_not_observed",
            "forward_persistence_contradiction",
            "inverse_not_observed_within_horizon",
            "recovery_persistence_not_observed",
            "recovery_persistence_contradiction",
            "cross_boundary_recovery"
          ]
        }
      }
    },
    "families": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "healthBoundary",
        "booleanAlive",
        "respawnBoundary",
        "pawnLinkPresence"
      ],
      "properties": {
        "healthBoundary": { "$ref": "#/$defs/family" },
        "booleanAlive": { "$ref": "#/$defs/family" },
        "respawnBoundary": { "$ref": "#/$defs/family" },
        "pawnLinkPresence": { "$ref": "#/$defs/family" }
      }
    },
    "horizonEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "horizonSeconds",
        "eligible",
        "anchorCoherentLifecycle",
        "controlCoherentLifecycle",
        "anchorAssignmentCount",
        "controlAssignmentCount",
        "sourceReuseCount"
      ],
      "properties": {
        "horizonSeconds": { "enum": [10, 20, 30, 60, 120, 180] },
        "eligible": { "type": "boolean" },
        "anchorCoherentLifecycle": { "type": "boolean" },
        "controlCoherentLifecycle": { "type": "boolean" },
        "anchorAssignmentCount": { "type": "integer", "minimum": 0 },
        "controlAssignmentCount": { "type": "integer", "minimum": 0 },
        "sourceReuseCount": { "type": "integer", "minimum": 0 }
      }
    },
    "fixedEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "horizonSeconds",
        "eligibleForFixedCohort",
        "anchorCoherentLifecycle",
        "controlCoherentLifecycle",
        "anchorAssignmentCount",
        "controlAssignmentCount",
        "sourceReuseCount"
      ],
      "properties": {
        "horizonSeconds": { "enum": [10, 20, 30, 60, 120, 180] },
        "eligibleForFixedCohort": { "type": "boolean" },
        "anchorCoherentLifecycle": { "type": "boolean" },
        "controlCoherentLifecycle": { "type": "boolean" },
        "anchorAssignmentCount": { "type": "integer", "minimum": 0 },
        "controlAssignmentCount": { "type": "integer", "minimum": 0 },
        "sourceReuseCount": { "type": "integer", "minimum": 0 }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surfaceResolvedLifecycleEvidenceKey",
        "eventCandidateKey",
        "sourceTransitionKey",
        "participantKey",
        "heroRefKey",
        "teamRefKey",
        "anchorNormalizedElapsedSecond",
        "matchedControlNormalizedElapsedSecond",
        "anchorAvailableFollowUpSeconds",
        "controlAvailableFollowUpSeconds",
        "pairedCommonFollowUpSeconds",
        "anchorFollowUpCause",
        "controlFollowUpCause",
        "commonFollowUpLimitingSide",
        "pairExposureStatus",
        "anchorFamilies",
        "controlFamilies",
        "anchorCompleteFamilyCount",
        "controlCompleteFamilyCount",
        "anchorCoherentLifecycle",
        "controlCoherentLifecycle",
        "surfaceSupportClass",
        "actualCrossSurfaceSupport",
        "crossBoundaryRecoveryObserved",
        "contradictionObserved",
        "ambiguousAssociation",
        "lifecycleEvidenceClass",
        "horizonSpecificEvidence",
        "fixed180CumulativeEvidence",
        "semanticStatus",
        "finalFact"
      ],
      "properties": {
        "surfaceResolvedLifecycleEvidenceKey": {
          "type": "string",
          "pattern": "^surface_resolved_lifecycle_[0-9]{6}$"
        },
        "eventCandidateKey": {
          "type": "string",
          "pattern": "^death_event_candidate_[0-9]{6}$"
        },
        "sourceTransitionKey": {
          "type": "string",
          "pattern": "^life_transition_[0-9]{6}$"
        },
        "participantKey": {
          "type": "string",
          "pattern": "^participant_[0-9]{2}$"
        },
        "heroRefKey": {
          "type": "string",
          "pattern": "^hero_ref_(?:[0-9]{2}|unknown_[0-9]{2})$"
        },
        "teamRefKey": {
          "type": "string",
          "pattern": "^team_ref_(?:[0-9]{2}|unknown_[0-9]{2})$"
        },
        "anchorNormalizedElapsedSecond": { "type": "integer", "minimum": 0 },
        "matchedControlNormalizedElapsedSecond": {
          "type": "integer",
          "minimum": 0
        },
        "anchorAvailableFollowUpSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 180
        },
        "controlAvailableFollowUpSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 180
        },
        "pairedCommonFollowUpSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 180
        },
        "anchorFollowUpCause": {
          "enum": [
            "next_participant_anchor",
            "replay_end",
            "policy_cap_180",
            "tied_causes"
          ]
        },
        "controlFollowUpCause": {
          "enum": [
            "next_real_participant_anchor",
            "replay_end",
            "policy_cap_180",
            "tied_causes"
          ]
        },
        "commonFollowUpLimitingSide": {
          "enum": ["anchor_side", "control_side", "equal_horizon"]
        },
        "pairExposureStatus": {
          "enum": [
            "fully_exposure_matched",
            "partially_exposure_matched",
            "insufficient_common_follow_up"
          ]
        },
        "anchorFamilies": { "$ref": "#/$defs/families" },
        "controlFamilies": { "$ref": "#/$defs/families" },
        "anchorCompleteFamilyCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "controlCompleteFamilyCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "anchorCoherentLifecycle": { "type": "boolean" },
        "controlCoherentLifecycle": { "type": "boolean" },
        "surfaceSupportClass": {
          "enum": [
            "boolean_respawn_same_surface_only",
            "health_supported_same_surface",
            "controller_and_pawn_surface_support",
            "controller_link_surface_support",
            "multiple_distinct_surfaces",
            "surface_conflicted",
            "surface_unresolved",
            "not_coherent"
          ]
        },
        "actualCrossSurfaceSupport": { "type": "boolean" },
        "crossBoundaryRecoveryObserved": { "type": "boolean" },
        "contradictionObserved": { "type": "boolean" },
        "ambiguousAssociation": { "type": "boolean" },
        "lifecycleEvidenceClass": {
          "enum": [
            "coherent_surface_resolved_lifecycle",
            "partial_surface_resolved_lifecycle",
            "event_relative_origin_inconsistent",
            "cross_boundary_recovery_violation",
            "contradictory_lifecycle",
            "ambiguous_lifecycle",
            "insufficient_primary_horizon",
            "insufficient_observation"
          ]
        },
        "horizonSpecificEvidence": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": { "$ref": "#/$defs/horizonEvidence" }
        },
        "fixed180CumulativeEvidence": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": { "$ref": "#/$defs/fixedEvidence" }
        },
        "semanticStatus": { "const": "unconfirmed_surface_resolved_lifecycle" },
        "finalFact": { "const": false }
      }
    },
    "offsetBucket": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "forwardCandidateCount",
        "originContinuousRate",
        "completeLifecycleRate"
      ],
      "properties": {
        "forwardCandidateCount": { "type": "integer", "minimum": 0 },
        "originContinuousRate": { "$ref": "#/$defs/rate" },
        "completeLifecycleRate": { "$ref": "#/$defs/rate" }
      }
    },
    "offsetDistribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minus2",
        "minus1",
        "zero",
        "plus1",
        "plus2",
        "ambiguousCandidateCount"
      ],
      "properties": {
        "minus2": { "$ref": "#/$defs/offsetBucket" },
        "minus1": { "$ref": "#/$defs/offsetBucket" },
        "zero": { "$ref": "#/$defs/offsetBucket" },
        "plus1": { "$ref": "#/$defs/offsetBucket" },
        "plus2": { "$ref": "#/$defs/offsetBucket" },
        "ambiguousCandidateCount": { "type": "integer", "minimum": 0 }
      }
    },
    "horizonResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cohortType",
        "horizonSeconds",
        "eligiblePairCount",
        "anchorCoherentLifecycleRate",
        "controlCoherentLifecycleRate",
        "pairedDifference",
        "pairedCensoringCount",
        "anchorAssignmentCount",
        "controlAssignmentCount",
        "duplicateAssignmentCount",
        "sourceReuseCount"
      ],
      "properties": {
        "cohortType": {
          "enum": [
            "horizon_specific_eligible_cohort",
            "fixed_180_second_cohort"
          ]
        },
        "horizonSeconds": { "enum": [10, 20, 30, 60, 120, 180] },
        "eligiblePairCount": { "type": "integer", "minimum": 0 },
        "anchorCoherentLifecycleRate": { "$ref": "#/$defs/rate" },
        "controlCoherentLifecycleRate": { "$ref": "#/$defs/rate" },
        "pairedDifference": { "type": "number", "minimum": -1, "maximum": 1 },
        "pairedCensoringCount": { "type": "integer", "minimum": 0 },
        "anchorAssignmentCount": { "type": "integer", "minimum": 0 },
        "controlAssignmentCount": { "type": "integer", "minimum": 0 },
        "duplicateAssignmentCount": { "type": "integer", "minimum": 0 },
        "sourceReuseCount": { "type": "integer", "minimum": 0 }
      }
    },
    "countMap": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "surfaceComposition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "booleanRespawnOnlyCount",
        "booleanRespawnOnlyRate",
        "healthSupportedCount",
        "healthSupportedRate",
        "pawnLinkSupportedCount",
        "pawnLinkSupportedRate",
        "controllerOnlyCoherentCount",
        "linkedPawnOnlyCoherentCount",
        "controllerAndPawnCoherentCount",
        "actualMultiSurfaceCoherentCount",
        "actualMultiSurfaceCoherentRate",
        "surfaceConflictCount",
        "surfaceUnavailableCount"
      ],
      "properties": {
        "booleanRespawnOnlyCount": { "type": "integer", "minimum": 0 },
        "booleanRespawnOnlyRate": { "$ref": "#/$defs/rate" },
        "healthSupportedCount": { "type": "integer", "minimum": 0 },
        "healthSupportedRate": { "$ref": "#/$defs/rate" },
        "pawnLinkSupportedCount": { "type": "integer", "minimum": 0 },
        "pawnLinkSupportedRate": { "$ref": "#/$defs/rate" },
        "controllerOnlyCoherentCount": { "type": "integer", "minimum": 0 },
        "linkedPawnOnlyCoherentCount": { "type": "integer", "minimum": 0 },
        "controllerAndPawnCoherentCount": { "type": "integer", "minimum": 0 },
        "actualMultiSurfaceCoherentCount": { "type": "integer", "minimum": 0 },
        "actualMultiSurfaceCoherentRate": { "$ref": "#/$defs/rate" },
        "surfaceConflictCount": { "type": "integer", "minimum": 0 },
        "surfaceUnavailableCount": { "type": "integer", "minimum": 0 }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "totalAnchors",
        "totalExactControls",
        "exactPairCount",
        "commonFollowUpDistribution",
        "anchorOffsetDistribution",
        "controlOffsetDistribution",
        "horizonSpecificResults",
        "fixed180CohortCurve",
        "surfaceComposition",
        "anchorTruncationCauses",
        "controlTruncationCauses",
        "commonLimitingSides",
        "crossBoundaryRecoveryCount",
        "contradictionCount",
        "ambiguityCount",
        "sourceReuseCount",
        "localPrimaryHorizonCriteriaMet",
        "operationalAssessmentLevel"
      ],
      "properties": {
        "totalAnchors": { "type": "integer", "minimum": 1 },
        "totalExactControls": { "type": "integer", "minimum": 1 },
        "exactPairCount": { "type": "integer", "minimum": 1 },
        "commonFollowUpDistribution": { "$ref": "#/$defs/countMap" },
        "anchorOffsetDistribution": { "$ref": "#/$defs/offsetDistribution" },
        "controlOffsetDistribution": { "$ref": "#/$defs/offsetDistribution" },
        "horizonSpecificResults": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": { "$ref": "#/$defs/horizonResult" }
        },
        "fixed180CohortCurve": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": { "$ref": "#/$defs/horizonResult" }
        },
        "surfaceComposition": { "$ref": "#/$defs/surfaceComposition" },
        "anchorTruncationCauses": { "$ref": "#/$defs/countMap" },
        "controlTruncationCauses": { "$ref": "#/$defs/countMap" },
        "commonLimitingSides": { "$ref": "#/$defs/countMap" },
        "crossBoundaryRecoveryCount": { "type": "integer", "minimum": 0 },
        "contradictionCount": { "type": "integer", "minimum": 0 },
        "ambiguityCount": { "type": "integer", "minimum": 0 },
        "sourceReuseCount": { "type": "integer", "minimum": 0 },
        "localPrimaryHorizonCriteriaMet": { "type": "boolean" },
        "operationalAssessmentLevel": {
          "enum": ["insufficient", "partial", "strong"]
        }
      }
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventWindowSymmetricLifecycleEvidenceAvailable",
        "independentlyRematchedHorizonEvidenceAvailable",
        "surfaceProvenanceMeasurable",
        "fixedCohortCompletionCurvesAvailable",
        "candidateLevelSurfaceResolvedLifecycleConsumptionAvailable",
        "readyForOperationalDeathFactPromotionReview",
        "readyForFinalDeathFacts",
        "readyForConfirmedWhoDied",
        "readyForAttribution",
        "readyForKillerVictim",
        "readyForTeamfight",
        "readyForGameplayInterpretation"
      ],
      "properties": {
        "eventWindowSymmetricLifecycleEvidenceAvailable": { "const": true },
        "independentlyRematchedHorizonEvidenceAvailable": { "const": true },
        "surfaceProvenanceMeasurable": { "const": true },
        "fixedCohortCompletionCurvesAvailable": { "const": true },
        "candidateLevelSurfaceResolvedLifecycleConsumptionAvailable": {
          "const": true
        },
        "readyForOperationalDeathFactPromotionReview": { "type": "boolean" },
        "readyForFinalDeathFacts": { "const": false },
        "readyForConfirmedWhoDied": { "const": false },
        "readyForAttribution": { "const": false },
        "readyForKillerVictim": { "const": false },
        "readyForTeamfight": { "const": false },
        "readyForGameplayInterpretation": { "const": false }
      }
    }
  }
}
